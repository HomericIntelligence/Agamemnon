# Containerfile for agamemnon-ci — CI image for the Agamemnon C++20 service.
#
# This image provides the complete CI toolchain:
# - Ubuntu 24.04 base with the system compiler (gcc/g++), clang, clang-format,
#   clang-tidy, ninja, OpenSSL + libcurl dev headers (same apt sources as the
#   ubuntu-24.04 runner image)
# - uv with the locked root toolchain environment pre-installed (cmake, conan,
#   ninja, gcovr, pre-commit — Odysseus ADR-018)
# - Security scanners pinned: gitleaks, trivy, syft, grype, actionlint
# - Non-root user 'ci' for rootless Podman compatibility
#
# Build (OCI-compliant — works with both podman and docker):
#   podman build -f ci/Containerfile -t agamemnon-ci:local .
#   docker build -f ci/Containerfile -t agamemnon-ci:local .
#
# Run:
#   podman run --rm -v .:/workspace:Z agamemnon-ci:local just lint
#   podman run --rm -v .:/workspace:Z agamemnon-ci:local cmake --preset release

# ============================================================================
# Stage 0: uv binary — installed from a pinned GitHub release so the checksum
# is reproducible and the build resolves identically under both podman/buildah
# and docker. (The ghcr.io astral-sh/uv image's tag scheme does not track uv
# CLI versions, so we pin the release tarball instead.)
# ============================================================================
FROM ubuntu:24.04@sha256:c4a8d5503dfb2a3eb8ab5f807da5bc69a85730fb49b5cfca2330194ebcc41c7b AS uv

COPY ci/install-tool.sh /opt/ci/install-tool.sh
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN bash /opt/ci/install-tool.sh uv /usr/local/bin

# ============================================================================
# Stage 1: Runtime — full toolchain in one image
# ============================================================================
FROM ubuntu:24.04@sha256:c4a8d5503dfb2a3eb8ab5f807da5bc69a85730fb49b5cfca2330194ebcc41c7b

LABEL org.opencontainers.image.title="agamemnon-ci"
LABEL org.opencontainers.image.description="CI container for Agamemnon — build, lint, test, security scans"
LABEL org.opencontainers.image.vendor="Agamemnon"
LABEL org.opencontainers.image.source="https://github.com/HomericIntelligence/Agamemnon"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/agamemnon-venv \
    UV_LINK_MODE=copy \
    # uv manages its own Python interpreter + tool envs; keep them under /opt
    # (not /root) so the non-root ci user can read them at runtime.
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_TOOL_DIR=/opt/uv-tools \
    UV_TOOL_BIN_DIR=/usr/local/bin \
    PATH="/opt/agamemnon-venv/bin:$PATH"

# System packages: compiler toolchain + dev headers (mirrors the CI job apt
# installs — same ubuntu-24.04 apt sources). apt-get upgrade picks up any
# security patches released after the base image was pinned.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    ca-certificates \
    clang \
    clang-format \
    clang-tidy \
    libclang-rt-18-dev \
    ninja-build \
    libssl-dev \
    libcurl4-openssl-dev \
    python3 \
    python3-pip \
    jq \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

# uv — pinned release (keep in sync with astral-sh/setup-uv in workflows)
COPY --from=uv /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/
COPY ci/install-tool.sh /opt/ci/install-tool.sh

# Layer: Dependency files — cache layer invalidated only when deps change.
WORKDIR /opt/agamemnon-build
COPY pyproject.toml uv.lock ./

# Install the locked root toolchain environment (cmake, conan, ninja, gcovr,
# pre-commit — ADR-018). The root project is tooling-only (package = false).
RUN uv sync --locked

# The native architecture selector preserves all pinned versions and verifies
# each release checksum before extraction. A failed install aborts the loop.
# CTest uses nats-server only for private loopback JetStream test instances.
RUN for tool in nats-server actionlint gitleaks trivy syft grype; do \
        bash /opt/ci/install-tool.sh "$tool" /usr/local/bin || exit "$?"; \
    done \
    && nats-server --version

# ruff + mypy + check-jsonschema for the Python client lint/typecheck jobs
# (installed as uv tools so bare invocations resolve on PATH, matching CI's
# `pip install ruff`). UV_TOOL_INSTALL_DIR points at /opt (not /root) so the
# installed venvs stay readable by the non-root ci user; UV_TOOL_BIN_DIR puts
# the entry-point symlinks on PATH.
RUN mkdir -p /opt/uv-tools && \
    uv tool install ruff \
    && uv tool install mypy \
    && uv tool install check-jsonschema \
    && uv tool install pip-audit \
    && chmod -R a+rX /opt/uv-tools /opt/uv-python

# Create non-root user for rootless Podman compatibility.
# UID 1000 is the default first user on most Linux systems, matching typical
# developer UIDs for smooth volume mount permissions without --userns=keep-id.
# Ubuntu 24.04 ships a default 'ubuntu' user at UID 1000 — replace it with 'ci'.
RUN userdel -r ubuntu 2>/dev/null || true; \
    groupadd -r ci && useradd -r -g ci -u 1000 -m -s /bin/bash ci && \
    chown -R ci:ci /opt/agamemnon-venv

# Working directory is the mounted repo root at runtime
WORKDIR /workspace

# No ENTRYPOINT — commands are provided externally by CI or run_ci_local.sh

USER ci
